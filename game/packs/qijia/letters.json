[
	{"id": "thanks_child_roll", "kind": "thanks", "hand": ["child"],
	 "text": "我说我{wish}，你就给了。我高兴得在炕上打了三个滚，大人说再滚炕就塌了。谢谢你。"},
	{"id": "thanks_child_pillow", "kind": "thanks", "hand": ["child"],
	 "text": "谢谢你。我{wish}，你真给了。我要藏在枕头底下，谁也不给看。就给你看。"},
	{"id": "thanks_scholar", "kind": "thanks", "hand": ["scholar"],
	 "text": "见字如面。前几日偶然念叨一句{wish}，不想竟真遂了愿。灯下摩挲良久，舍不得放下。无以为报，唯有多念几页书。"},
	{"id": "thanks_plain", "kind": "thanks", "hand": ["plain"],
	 "text": "跟你说一声，那事成了。我{wish}，本没指望真能有，今早一睁眼就在手边。我嘴笨，就写这么几个字。谢谢。"},
	{"id": "thanks_dictated", "kind": "thanks", "hand": ["dictated"],
	 "text": "我不识字，叫{scribe}替我写几句。我{wish}，你就给办了。心里头热乎，一上午干活都没觉着累。就这些，谢谢你。"},

	{"id": "ask_child", "kind": "ask", "hand": ["child"],
	 "text": "我{wish}。就一个。我这几天都没哭，还帮着喂鸡了。行不行？",
	 "choices": [
		{"label": "行，等着", "effect": {"type": "wish_keep", "hours": 12, "amount": 5}},
		{"label": "这回不行", "effect": {"type": "wish_drop", "amount": -5}},
		{"label": "过两天再说", "effect": {"type": "later"}}]},
	{"id": "ask_scholar", "kind": "ask", "hand": ["scholar"],
	 "text": "见字如面。近来{wish}，夜里常想起，几番提笔又搁下。家中用度不宽，本不该开口。若能成全，自当铭记；若有难处，也请直言。",
	 "choices": [
		{"label": "应下", "effect": {"type": "wish_keep", "hours": 12, "amount": 5}},
		{"label": "回了", "effect": {"type": "wish_drop", "amount": -5}},
		{"label": "容我想想", "effect": {"type": "later"}}]},
	{"id": "ask_plain", "kind": "ask", "hand": ["plain"],
	 "text": "有件事想跟你商量：我{wish}。不急，你手头宽了再说。要是不成，也回我一声，省得我老惦记。",
	 "choices": [
		{"label": "成，回头就办", "effect": {"type": "wish_keep", "hours": 12, "amount": 5}},
		{"label": "这回不成", "effect": {"type": "wish_drop", "amount": -5}},
		{"label": "过些日子再说", "effect": {"type": "later"}}]},
	{"id": "ask_dictated", "kind": "ask", "hand": ["dictated"],
	 "text": "我说，{scribe}写。我{wish}。话说出口有点臊，憋着更难受。你看着办吧。",
	 "choices": [
		{"label": "答应", "effect": {"type": "wish_keep", "hours": 12, "amount": 5}},
		{"label": "回绝", "effect": {"type": "wish_drop", "amount": -5}},
		{"label": "再说", "effect": {"type": "later"}}]},

	{"id": "sad_child", "kind": "sad", "hand": ["child"],
	 "text": "我不高兴。没人跟我玩，饭也不香。你能不能跟我说句话。",
	 "choices": [
		{"label": "回几句哄一哄", "effect": {"type": "mood", "amount": 12}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "sad_scholar", "kind": "sad", "hand": ["scholar"],
	 "text": "见字如面。这几日心绪不宁，书摊在案上，半天翻不过一页。窗外的雀儿叫得吵人，往常竟不觉得。说与你听，也就是说说。",
	 "choices": [
		{"label": "回信宽慰", "effect": {"type": "mood", "amount": 12}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "sad_plain", "kind": "sad", "hand": ["plain"],
	 "text": "这两天提不起劲，干活老出错，针扎了好几回手。也说不上为啥。跟你说说，心里能松快点。",
	 "choices": [
		{"label": "回信劝劝", "effect": {"type": "mood", "amount": 12}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "sad_dictated", "kind": "sad", "hand": ["dictated"],
	 "text": "{scribe}问我写啥，我半天没说出话。就写我这两天心里堵吧。饭吃一半就放下了，夜里睁着眼听房梁响。",
	 "choices": [
		{"label": "托人回几句暖话", "effect": {"type": "mood", "amount": 12}},
		{"label": "改日再回", "effect": {"type": "later"}}]},

	{"id": "low_child", "kind": "depressed", "hand": ["child"],
	 "text": "我不想起来。被子里黑黑的，好一点。你别生气。",
	 "choices": [
		{"label": "写信哄一哄", "effect": {"type": "mood", "amount": 15}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "low_scholar", "kind": "depressed", "hand": ["scholar"],
	 "text": "提笔又放下好几回。近来连字也懒得写，墨干在砚台里，结了一层壳。不知还能与谁说，只好写给你。",
	 "choices": [
		{"label": "回一封长信", "effect": {"type": "mood", "amount": 15}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "low_plain", "kind": "depressed", "hand": ["plain"],
	 "text": "我也不知道怎么了，躺着不想动，碗端起来又放下。别人跟我说话，我听着隔了一堵墙似的。就是想跟你说一声。",
	 "choices": [
		{"label": "回信劝劝", "effect": {"type": "mood", "amount": 15}},
		{"label": "改日再回", "effect": {"type": "later"}}]},
	{"id": "low_dictated", "kind": "depressed", "hand": ["dictated"],
	 "text": "我让{scribe}写，他问写啥，我说就写我想睡。这几天也睡不着，就是躺着，盯着窗户纸上那个窟窿。",
	 "choices": [
		{"label": "托人捎几句话", "effect": {"type": "mood", "amount": 15}},
		{"label": "改日再回", "effect": {"type": "later"}}]},

	{"id": "ill_child", "kind": "ill", "hand": ["child"],
	 "text": "我病了。头烫，嗓子疼，药好苦。我想吃甜的。"},
	{"id": "ill_scholar", "kind": "ill", "hand": ["scholar"],
	 "text": "偶感不适，头重脚轻，伏案半刻便眼花。想是近来贪凉所致。暂且搁笔，待好些再写。"},
	{"id": "ill_plain", "kind": "ill", "hand": ["plain"],
	 "text": "我身上不大得劲，浑身发沉，起来走两步就出汗。不打紧，躺两天就好。家里的活先放放。"},
	{"id": "ill_dictated", "kind": "ill", "hand": ["dictated"],
	 "text": "{scribe}替我写：我病了，身上一阵冷一阵热，捂了两床被子还打哆嗦。没啥事，就是想有人知道。"},

	{"id": "birth_scholar_boy", "kind": "birth", "hand": ["scholar"], "if": {"gender": "male"},
	 "text": "见字如面。今日家中添一男丁，取名{child}。哭声洪亮，隔壁都听见了。小手攥着我一根指头不放，力气不小。特此报喜。"},
	{"id": "birth_scholar_girl", "kind": "birth", "hand": ["scholar"], "if": {"gender": "female"},
	 "text": "见字如面。今日家中添一千金，取名{child}。眉眼细细的，睡着了嘴角还动。抱在怀里轻得很，不敢使劲。特此报喜。"},
	{"id": "birth_plain_boy", "kind": "birth", "hand": ["plain"], "if": {"gender": "male"},
	 "text": "生了，是个小子，叫{child}。哭起来嗓门大得很，鸡都吓得扑腾。大人孩子都好，你放心。"},
	{"id": "birth_plain_girl", "kind": "birth", "hand": ["plain"], "if": {"gender": "female"},
	 "text": "生了，是个闺女，叫{child}。小脸皱巴巴的，抓着人手指头就不撒开。大人孩子都好，你放心。"},
	{"id": "birth_dictated", "kind": "birth", "hand": ["dictated"],
	 "text": "叫{scribe}赶紧写下来：家里添人了，叫{child}。我抱了一下，软乎乎的，比一捆麦秸还轻。大人孩子都好。"},

	{"id": "death_scholar", "kind": "death", "hand": ["scholar"],
	 "text": "{dead}于今日辞世，享年{age}。晨起为其梳头更衣，换了过年那身。灶上的粥盛了两碗，一碗无人动。执笔至此，写不下去了。"},
	{"id": "death_plain", "kind": "death", "hand": ["plain"],
	 "text": "{dead}没了，{age}岁。夜里睡过去就没再醒，走得不算受罪。屋里还摆着{dead}的鞋，没人舍得收。"},
	{"id": "death_plain_neglect", "kind": "death", "hand": ["plain"], "if": {"cause": "neglect"},
	 "text": "{dead}没撑过去。这些天饭没吃上几口，身子一天比一天轻，抱起来跟抱一捆柴似的。该早些留心的。"},
	{"id": "death_dictated", "kind": "death", "hand": ["dictated"],
	 "text": "我说，{scribe}写。{dead}走了，{age}岁。我在门槛上坐了一下午，日头落了才想起来，还没跟你说。"},
	{"id": "death_child", "kind": "death", "hand": ["child"],
	 "text": "{dead}睡着了，叫不醒。大人们都在哭。我没哭，我把我画的画塞到{dead}手里了。"},

	{"id": "married_scholar", "kind": "married", "hand": ["scholar"],
	 "text": "见字如面。今日{spouse_full}进门，拜过天地。红烛点到三更，蜡泪堆了一桌角。往后家里多一双筷子，也多一盏灯。"},
	{"id": "married_plain", "kind": "married", "hand": ["plain"],
	 "text": "{spouse}进门了。酒席不大，就请了左右邻居，坐满两张桌子。{spouse}端茶的时候手抖，洒了我一袖子。往后就是一家人了。"},
	{"id": "married_dictated", "kind": "married", "hand": ["dictated"],
	 "text": "{scribe}替我写：成亲了，{spouse}今天进的门。我嘴笨，说不出啥，就是一整天都在笑，腮帮子到这会儿还酸。"},

	{"id": "took_up_scholar", "kind": "took_up", "hand": ["scholar"],
	 "text": "见字如面。转眼已是成人，往后便以{job}为业。从前常趴在先生窗外偷听，如今可以正经坐进去了。只怕资质平平，辜负家里。",
	 "choices": [
		{"label": "就学{job}吧", "effect": {"type": "mood", "amount": 6}},
		{"label": "改学{alt}", "effect": {"type": "change_track"}}]},
	{"id": "took_up_plain", "kind": "took_up", "hand": ["plain"],
	 "text": "我长大了，想去学{job}。小时候老往那边跑，看人家干活能看一下午。你说行不行？你要觉得{alt}更好，我也听你的。",
	 "choices": [
		{"label": "就学{job}吧", "effect": {"type": "mood", "amount": 6}},
		{"label": "改学{alt}", "effect": {"type": "change_track"}}]},
	{"id": "took_up_dictated", "kind": "took_up", "hand": ["dictated"],
	 "text": "我让{scribe}帮我写：我想学{job}。我手笨，字认不全，干活可不偷懒。你要觉得{alt}好，我就去学{alt}。",
	 "choices": [
		{"label": "就学{job}吧", "effect": {"type": "mood", "amount": 6}},
		{"label": "改学{alt}", "effect": {"type": "change_track"}}]},

	{"id": "pet_ran_child_hungry", "kind": "pet_ran", "hand": ["child"], "if": {"hungry": "true"},
	 "text": "{pet}跑了。它饿了好几天，碗是空的，我忘了。我在门口等它，等到天黑。"},
	{"id": "pet_ran_child_lonely", "kind": "pet_ran", "hand": ["child"], "if": {"hungry": "false"},
	 "text": "{pet}跑了。它好多天不理人了，叫它也不过来。是不是我们对它不好。"},
	{"id": "pet_ran_grown", "kind": "pet_ran", "hand": ["scholar", "plain"],
	 "text": "家里的{pet_kind}{pet}这两天不见了，院前院后都找过，喊哑了嗓子也没回音。门口那只空碗还摆着，没人收。"},
	{"id": "pet_ran_dictated", "kind": "pet_ran", "hand": ["dictated"],
	 "text": "{scribe}替我写：{pet}跑了。我走到河边又走回来，鞋底沾了两斤泥，没见着。"},
	{"id": "pet_back_child", "kind": "pet_back", "hand": ["child"],
	 "text": "{pet}回来了！一身泥，瘦了，它还认得我，一个劲舔我的手。我分了它半个馍。"},
	{"id": "pet_back_grown", "kind": "pet_back", "hand": ["scholar", "plain", "dictated"],
	 "text": "{pet}自己回来了，蹲在门口，毛乱糟糟的。孩子们抱着不撒手。给它添了碗饭，三两口就舔干净了。"},

	{"id": "proposal_girl", "kind": "proposal", "if": {"gender": "female"}, "from": "王媒婆", "sign": "王媒婆　托人代笔",
	 "text": "府上安好。有一门亲事说给{target}：{match_full}，{age}岁的{match_kind}，手脚勤快，攒了{savings}文压箱钱。我见过人，眉眼周正，说话不紧不慢。成不成，给个回话。",
	 "choices": [
		{"label": "应下这门亲", "effect": {"type": "answer_proposal", "accept": true}},
		{"label": "回绝", "effect": {"type": "answer_proposal", "accept": false}},
		{"label": "再看看", "effect": {"type": "later"}}]},
	{"id": "proposal_boy", "kind": "proposal", "if": {"gender": "male"}, "from": "王媒婆", "sign": "王媒婆　托人代笔",
	 "text": "府上安好。给{target}说门亲：{match_full}，{age}岁的{match_kind}，肯下力气，带着{savings}文家底。人老实，见了生人脸先红。合不合适，捎个信来。",
	 "choices": [
		{"label": "应下这门亲", "effect": {"type": "answer_proposal", "accept": true}},
		{"label": "回绝", "effect": {"type": "answer_proposal", "accept": false}},
		{"label": "再看看", "effect": {"type": "later"}}]},

	{"id": "kin_borrow", "kind": "kin", "from": "河那边的远房表叔", "sign": "表叔　托人代笔",
	 "text": "家里都好吧。今年河那边发了水，地里的麦子泡烂在泥里。厚着脸皮开口，能不能借六十文周转，开春一准还上。",
	 "choices": [
		{"label": "捎去六十文", "effect": {"type": "money", "amount": -60}},
		{"label": "回信说手头也紧", "effect": {"type": "none"}}]},
	{"id": "kin_gift", "kind": "kin", "from": "城里的远房姑婆", "sign": "姑婆",
	 "text": "听说你们落了脚，日子过起来了。我腿脚不灵便，去不了，托赶车的捎去四十文，给孩子们扯块布。",
	 "choices": [
		{"label": "收下", "effect": {"type": "money", "amount": 40}}]},
	{"id": "kin_persimmons", "kind": "kin", "from": "河那边的远房表叔", "sign": "表叔　托人代笔",
	 "text": "今年院里的柿子结得多，压断了一根枝子，掉在地上的都让鸡啄了。想起你们，就写两句。", "weight": 0.5},

	{"id": "story_ayun_coming", "kind": "story", "story": "embroidered_shoe", "on": "finale", "from": "阿芸", "sign": "阿芸",
	 "text": "我是从前住在这院里的人。听说井台边的东西都叫你们捡着了。我老了，眼也花，想回去看一眼那口井。过几日到门口，不进屋，看一眼就走。"},
	{"id": "story_ayun_after", "kind": "story", "story": "embroidered_shoe", "on": "done", "from": "阿芸的孙子", "sign": "阿芸之孙　敬上",
	 "text": "奶奶从你们那儿回来，饭量大了，夜里也不念叨了。她让我写信说一声：那只绣绷，挂在你们屋里就好。"},
	{"id": "story_shadow_hint", "kind": "story", "story": "little_shadow", "on": "unlocked", "from": "隔壁的孙婆婆", "sign": "孙婆婆　孙子代笔",
	 "text": "听说你家添了孙辈，我老婆子替你们高兴。早些年你们那院子里也住过一个小娃，夜里爱在院角跑。后来就没再听见他的脚步声了。孩子要看紧些。"},
	{"id": "story_scholar_hint", "kind": "story", "story": "scholar_silver", "on": "unlocked", "from": "村塾的周先生", "sign": "周某　顿首",
	 "text": "闻府上新起了书房，可喜。早年那院里住过一位读书人，考了九回没中，屋里的灯常点到天亮。他的诗笺满屋乱飞，我小时候还捡过一张。打扫时若见着带字的纸，留一留。"},
	{"id": "story_scholar_after", "kind": "story", "story": "scholar_silver", "on": "done", "from": "村塾的周先生", "sign": "周某　顿首",
	 "text": "听说你们在葡萄架底下挖着了东西。那位老先生若还在，大概会捋着胡子说一句：够了。"}
]
