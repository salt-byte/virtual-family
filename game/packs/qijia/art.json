		"adult_4": {"stage": "adult", "sex": "male", "rig": "rigs/adult_4/adult_4.rig.json", "rig_front": "rigs/adult_4_front/adult_4_front.rig.json", "rig_back": "rigs/adult_4_back/adult_4_back.rig.json", "rig_front34": "rigs/adult_4_front34/adult_4_front34.rig.json", "rig_back34": "rigs/adult_4_back34/adult_4_back34.rig.json", "height": 92, "portrait": "portraits/adult_4.png", "asleep": "sleeper", "name": "木匠", "description": "方下巴，一圈短胡茬，白布头巾在脑后打个结。深褐短褂外挂一条土黄帆布围裙，胸口一只小口袋，腿上打着绑腿。"},
		"adult_5": {"stage": "adult", "sex": "female", "rig": "rigs/adult_5/adult_5.rig.json", "rig_front": "rigs/adult_5_front/adult_5_front.rig.json", "rig_back": "rigs/adult_5_back/adult_5_back.rig.json", "rig_front34": "rigs/adult_5_front34/adult_5_front34.rig.json", "rig_back34": "rigs/adult_5_back34/adult_5_back34.rig.json", "height": 82, "portrait": "portraits/adult_5.png", "asleep": "sleeper", "name": "绣娘", "description": "瓜子脸，脑后一个圆髻，横插一根银簪，簪头一点红绒花。桃粉大襟袄滚月白边，脚上一双绣花鞋。"},
		"adult_6": {"stage": "adult", "sex": "female", "rig": "rigs/adult_6/adult_6.rig.json", "rig_front": "rigs/adult_6_front/adult_6_front.rig.json", "rig_back": "rigs/adult_6_back/adult_6_back.rig.json", "rig_front34": "rigs/adult_6_front34/adult_6_front34.rig.json", "rig_back34": "rigs/adult_6_back34/adult_6_back34.rig.json", "height": 88, "portrait": "portraits/adult_6.png", "asleep": "sleeper", "name": "豆腐娘", "description": "圆脸红扑扑，一笑露出一排牙。白布头巾把头发全包住，靛蓝碎花袄外面套着白套袖，腰里系白围裙。"},
		"adult_7": {"stage": "adult", "sex": "female", "rig": "rigs/adult_7/adult_7.rig.json", "rig_front": "rigs/adult_7_front/adult_7_front.rig.json", "rig_back": "rigs/adult_7_back/adult_7_back.rig.json", "rig_front34": "rigs/adult_7_front34/adult_7_front34.rig.json", "rig_back34": "rigs/adult_7_back34/adult_7_back34.rig.json", "height": 86, "portrait": "portraits/adult_7.png", "asleep": "sleeper", "name": "采药姑娘", "description": "齐眉刘海，两条麻花辫垂在肩后，辫梢扎红头绳。砖红短袄，腰上斜挎一只浅棕布药囊，腿上打浅灰绑腿。"},
